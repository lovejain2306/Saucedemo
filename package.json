{
  "name": "saucedemo-playwright-bdd",
  "version": "1.0.0",
  "description": "Playwright BDD framework for Sauce Demo automation",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:spec": "playwright test --spec",
    "bdd": "npx cucumber-js",
    "bdd:report": "node cucumber-html-report.js"
  },
  "keywords": ["playwright", "bdd", "cucumber", "automation"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^9.5.1",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "playwright": "^1.40.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  }
}
